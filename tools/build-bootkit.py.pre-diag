#!/usr/bin/env python3
"""Persistent, self-verifying builder for the iPhone3,3 Android boot kit.

Rebuilds from pristine sources every time (no incremental drift):
  bootkit/zImage      - instrumented zImage (decompressor + handoff)
  bootkit/kcaves.bin  - checkpoint blob, uploaded to PA 0x300000
  bootkit/stub.bin    - boot stub (built by build-t4stub.py)
  bootkit/boot-android.sh - one-shot boot script (absolute paths)

Every address below is derived from named constants, and the build ends
with a full audit that re-derives page-table slots independently. If any
assertion fails, nothing is written.

Key facts (verified against pristine t4-vmlinux.bin):
  vmlinux file = VA - 0xC0008000. head.S:
    0x24  bl __vet_atags          (PA 0x8024)
    0x28  bl __create_page_tables (PA 0x802C after 0x8028? -> see audit)
    0x3C  b   0x810C (__enable_mmu)
    0x110 mov r5,#0x15   0x114 mcr domain   0x118 mcr TTBR
    0x120 mov r0,r0      0x124 mcr SCTLR    0x128 mrc  0x130 mov r3,sp
    0x134 mov pc,r3      0x8180 __mmap_switched   0x85F4 start_kernel
  __create_page_tables: pgtables at PA 0x4000 (r8 = 0xC0000000 wraps
  around with delta 0x40000000 -> 0). Identity loop end = word[0x108];
  kernel-VA loop end = word[0xFC]. L1 slot for VA section S:
    identity: 0x4000 + 4*S          kernel VA: 0x7000 + 4*(S - 0xC00)
  PAGE_OFFSET = 0xC0000000, so FB PA 0x0F700000 <-> VA 0xCF700000
  (0xC0000000 + 0x0F700000 = 0xCF700000 - CHECK THIS EVERY TIME).
"""
import gzip, os, struct, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
KIT = os.path.join(ROOT, "bootkit")   # replaced by set_profile()

KERNEL_SRC = os.environ.get("T4_KERNEL", os.path.expanduser("~/Desktop/iphone3,3/t4-kernel.bin"))
VMLINUX_SRC = os.environ.get("T4_VMLINUX", os.path.expanduser("~/Desktop/iphone3,3/t4-vmlinux.bin"))
INITRD_SRC = os.environ.get("T4_INITRD", os.path.expanduser("~/Desktop/iphone3,3/t4-initrd.bin"))
OIBSEND = os.path.join(HERE, "oibsend.py")

FB, FBE = 0x0F700000, 0x0FA00000          # physical framebuffer (xRGB8888)
KB, CB = 0x8000, 0x300000                 # kernel PA base / cave blob PA
BASE = 0x44000000                         # zImage load PA
RAM_BASE = 0                              # PA the kernel maps at PAGE_OFFSET

def set_profile(name):
    """phone: PA window 0 (aliased); qemu: virt RAM at 0x40000000."""
    global BASE, KB, CB, FB, FBE, RAM_BASE, KIT, VCB, SCTLR_MINIMAL
    if name == "phone":
        # kernel bss-clear zeroes PA 0x28D9C0..0x3CA020 (head data words
        # [1d0]/[1d4]) -> the blob MUST sit outside that and inside the
        # +-32MB branch range of the kernel head (KB..KB+32M).
        # 0x1000000 (16MB): free (zImage window 64MB, initrd 144MB, stub 66MB).
        BASE, KB, CB, RAM_BASE = 0x44000000, 0x8000, 0x1000000, 0x0
        FB, FBE = 0x0F700000, 0x0FA00000
        VCB = 0xC0000000 + (CB - RAM_BASE)
        SCTLR_MINIMAL = True       # phone: A4 may reject kernel SCTLR mask bits
        KIT = os.path.join(ROOT, "bootkit")
    elif name == "qemu":
        # virt: RAM 0x40000000..0x50000000. zrel 0x40008000, PT at +16KB,
        # bss 0x4028D9C0..0x403CA020 -> blob at 0x41800000 (free, between
        # zImage end 0x41149xxx and stub 0x42000000, inside branch range).
        BASE, KB, CB, RAM_BASE = 0x41000000, 0x40008000, 0x41800000, 0x40000000
        FB, FBE = 0x4F800000, 0x4F801000
        VCB = 0xC0000000 + (CB - RAM_BASE)
        SCTLR_MINIMAL = False      # qemu: the kernel's own mask works (A7)
        KIT = os.path.join(ROOT, "bootkit", "qemu")
    else:
        raise ValueError(name)
VB, VCB = 0xC0008000, 0xC0300000          # kernel VA base / blob VA base
BASE = 0x44000000                         # zImage load PA
PAGE_OFFSET = 0xC0000000
VFB = PAGE_OFFSET + FB                    # 0xCF700000  <-- the fixed value
VFBE = PAGE_OFFSET + FBE                  # 0xCFA00000

PIGGY_OFF, OLD_END = 0x469B, 0x14938A
OLD_PIGGY_LEN = OLD_END - PIGGY_OFF
TRUNCATION_LIMIT = 2644416 + 260          # decompressor loses the tail past ~+272

# start_kernel bisect cascade: (name, file offset of patched insn, color).
# All post-MMU (VA); scratch (1,2,12) — r1/r2 dead at start_kernel entry
# (head stored mach/atags to memory), r12 is AAPCS scratch.
M_SITES = [
    ("m3",  0x5F4, 0x80400080),   # start_kernel entry (push {r0-r6,lr})
    ("m4",  0x658, 0x00808040),   # bl setup_arch (apple machine init!)
    ("m5",  0x6B8, 0x80804000),   # bl (mm-era init)
    ("m6",  0x6C0, 0x4080FF00),   # bl sched_init
    ("m7",  0x6D4, 0x40008080),   # bl early_trap_init
    ("m8",  0x704, 0xFF404000),   # bl early_irq_init
    ("m9",  0x708, 0x004080FF),   # bl init_IRQ
    ("m10", 0x740, 0x80FF8000),   # bl console_init (first visible out!)
]


def B(frm, to):
    d = (to - (frm + 8)) // 4
    assert -(1 << 23) <= d < (1 << 23), hex(frm) + "->" + hex(to)
    return 0xEA000000 | (d & 0xFFFFFF)


def BL(frm, to):
    d = (to - (frm + 8)) // 4
    assert -(1 << 23) <= d < (1 << 23), hex(frm) + "->" + hex(to)
    return 0xEB000000 | (d & 0xFFFFFF)


def brtarget(word, addr):
    return addr + 8 + (((word & 0xFFFFFF) ^ 0x800000) - 0x800000) * 4


class Asm:
    """Tiny label assembler for cave bodies (runs at one address space)."""

    def __init__(self, base):
        self.base = base
        self.ins, self.labels, self.fixups, self.lits = [], {}, [], {}
        self.ext = {}      # idx -> absolute target for external branches
        self.nc = 0

    def emit(self, w): self.ins.append(w)
    def label(self, n): self.labels[n] = len(self.ins)
    def ldr(self, reg, name):
        self.fixups.append(("lit", len(self.ins), reg, name))
        self.emit(0xE59F0000 | (reg << 12))

    def br(self, op, name):
        if name in ("__ext__",):
            raise ValueError
        self.fixups.append(("br", len(self.ins), op, name))
        self.emit(0)

    def bext(self, target):
        idx = len(self.ins)
        self.ext[idx] = target
        self.ins.append(0xEA000000)    # keep B (unconditional) opcode through finish()

    def bl(self, target):
        idx = len(self.ins)
        self.ext[idx] = target
        self.ins.append(0xEB000000)      # keep BL opcode through finish()

    def paint(self, scratch, color):
        a, b, c = scratch
        self.nc += 1
        cn = "COL%d" % self.nc
        self.lits[cn] = color
        self.ldr(a, "FB"); self.ldr(b, "FBE"); self.ldr(c, cn)
        self.emit(0xE4800004 | (a << 16) | (c << 12))    # str c,[a],#4
        self.emit(0xE1500000 | (a << 16) | b)            # cmp a,b
        self.emit(0x1AFFFFFC)                            # bne -3
        self.emit(0xE3A00710 | (c << 12))                # mov c,#0x400000
        self.emit(0xE2500001 | (c << 16) | (c << 12))    # subs c,c,#1
        self.emit(0x1AFFFFFD)                             # bne -2

    def finish(self, extra_lits, fb, fbe):
        lits = dict(self.lits)
        lits.update(extra_lits)
        lits["FB"] = fb; lits["FBE"] = fbe
        litpos = {}
        for name, val in lits.items():
            litpos[name] = len(self.ins)
            self.ins.append(val)
        for kind, idx, a, name in self.fixups:
            if kind == "lit":
                off = (litpos[name] - idx) * 4 - 8
                assert off >= 0, "literal %s behind ldr (cave too big?)" % name
                self.ins[idx] = 0xE59F0000 | (a << 12) | off
            else:
                self.ins[idx] = (a << 24) | ((self.labels[name] - idx - 2) & 0xFFFFFF)
        for idx, target in self.ext.items():
            op = self.ins[idx] >> 24
            d = (target - (self.base + idx * 4 + 8)) // 4
            assert -(1 << 23) <= d < (1 << 23), "branch out of range"
            self.ins[idx] = (op << 24) | (d & 0xFFFFFF)
            if (target & 1) or (self.base + idx * 4) & 1:
                raise AssertionError("branch at odd address")
        return self.ins


def cave(base, scratch, color, mid, ret, fb=None, fbe=None):
    """Standard paint+delay cave: ldr FB/FBE/COL, paint, mid..., b ret."""
    a = Asm(base)
    a.paint(scratch, color)
    for w in mid:
        a.emit(w)
    if ret is not None:
        a.bext(ret)
    return a.finish({}, fb if fb is not None else FB, fbe if fbe is not None else FBE)


# ----------------------------------------------------------------------------
# 1. kcaves.bin - checkpoint blob at PA 0x300000
# ----------------------------------------------------------------------------
def build_blob():
    caves, off = [], 0

    def add(fn, nwords=None):
        nonlocal off
        base = CB + off
        ins = fn(base)
        if nwords is not None:
            assert len(ins) == nwords, (len(ins), nwords)
        caves.append(ins)
        off += len(ins) * 4
        return base

    o = {}

    # c0: kernel entry. r0/r3/r4 dead (r1 mach, r2 atags live).
    o["c0"] = add(lambda b: cave(b, (0, 3, 4), 0x00FF00FF, [], KB + 0x04), 13)
    # cL: lookup 2nd insn. r1/r2/r3/r9/lr live; scratch (0,4,5); re-exec ldm.
    o["cL"] = add(lambda b: cave(b, (0, 4, 5), 0xFFFFFFFF, [0xE8930070], KB + 0x12F98), 14)
    # cA: post-lookup. r1/r2/r5 live; scratch (0,3,4); re-exec movs sl,r5.
    o["cA"] = add(lambda b: cave(b, (0, 3, 4), 0xFFFF0000, [0xE1B0A005], KB + 0x10), 14)
    # cD: not-found hang.
    o["cD"] = add(lambda b: cave(b, (0, 1, 2), 0x0000FFFF, [0xEAFFFFFE], KB + 0x10), 14)
    # k1: replaces bl __vet_atags (PA 0x8024). r1/r2/r4/r8/r10 live; (0,3,6).
    o["k1"] = add(lambda b: cave(b, (0, 3, 6), 0x00FF8000, [], KB + 0x28)[:-1]
                  + [BL(b + 9 * 4, KB + 0x138)] + cave(b, (0, 3, 6), 0, [], KB + 0x28)[10:]
                  if False else _cave_bl(b, (0, 3, 6), 0x00FF8000, KB + 0x138, KB + 0x28), 14)
    # k2: replaces bl __create_page_tables (PA 0x8028). r4/r8/r10 live; (0,3,6).
    o["k2"] = add(lambda b: _cave_bl(b, (0, 3, 6), 0x008000FF, KB + 0x4C, KB + 0x2C), 14)
    # k3: replaces mov r8,r4 (PA 0x8034). r0 live (pre-v7_setup: dead); (0,3,6).
    o["k3"] = add(lambda b: cave(b, (0, 3, 6), 0x000080FF, [0xE1A08004], KB + 0x38), 14)
    # k4: replaces b 0x810C (PA 0x803C). r0 = SCTLR VALUE - LIVE! scratch (3,5,6).
    o["k4"] = add(lambda b: cave(b, (3, 5, 6), 0x00FF0080, [], KB + 0x10C), 13)
    # v1: vet entry (PA 0x8138). re-exec tst r2,#3. r1/r2/r9 live; (0,5,6).
    o["v1"] = add(lambda b: cave(b, (0, 5, 6), 0x00FF8080, [0xE3320003], KB + 0x13C), 14)
    # v2: vet OK return (PA 0x8160) - mov pc,lr, hang-free exit.
    o["v2"] = add(lambda b: cave(b, (0, 5, 6), 0x0080FF00, [0xE1A0F00E], None), 13)
    # v3: vet fail return (PA 0x8164) - mov r2,#0; mov pc,lr.
    o["v3"] = add(lambda b: cave(b, (0, 5, 6), 0x00008080, [0xE3A02000, 0xE1A0F00E], None), 14)

    # m0: replaces mov r5,#0x15 (PA KB+0x110). PRE-MMU. r0 = SCTLR live!
    # Verifies r4 (TTBR), and the five page-table words that must exist
    # before the MMU goes on. Slot formulas work for BOTH profiles:
    #   PT_BASE = KB - 0x4000 (page tables sit just below the kernel image)
    #   identity slot for section S  = PT + 4*S
    #   kernel-VA slot for VA page C00+k = PT + 0x3000 + 4*k
    #   expected descriptor = (PA_section << 20) | 0xC0E
    _PT = KB - 0x4000
    _PT_TTBR = _PT | 0x59
    _id0_slot = _PT + 4 * (KB >> 20)
    _id0_exp = (KB & 0xFFF00000) | 0xC0E
    _kva_slot = _PT + 0x3000
    _blob_slot = _PT + 0x3000 + 4 * ((CB - RAM_BASE) >> 20)
    _blob_exp = (CB & 0xFFF00000) | 0xC0E
    _vfb_slot = _PT + 0x3000 + 4 * ((FB - RAM_BASE) >> 20)
    _vfb_exp = (FB & 0xFFF00000) | 0xC0E
    _ifb_slot = _PT + 4 * (FB >> 20)
    _ifb_exp = _vfb_exp

    def m0(b):
        a = Asm(b)
        a.paint((3, 5, 6), 0x00808080)             # GRAY
        a.ldr(3, "TTBR"); a.emit(0xE1540003); a.br(0x1A, "fix")
        a.label("pt")
        for name, slot, exp, bad in (("PT_ID0", _id0_slot, _id0_exp, "bad_id"),
                                     ("PT_KVA", _kva_slot, _id0_exp, "bad_kva"),
                                     ("PT_BLOB", _blob_slot, _blob_exp, "bad_blob"),
                                     ("PT_VFB", _vfb_slot, _vfb_exp, "bad_vfb"),
                                     ("PT_IFB", _ifb_slot, _ifb_exp, "bad_ifb")):
            a.ldr(3, name)
            a.emit(0xE5935000)                       # ldr r5,[r3]
            a.ldr(6, name + "X")
            a.emit(0xE1550006)                       # cmp r5,r6
            a.br(0x1A, bad)
        a.emit(0xE3A05015)                           # mov r5,#0x15 (re-exec)
        a.bext(KB + 0x114)
        a.label("fix")
        a.paint((3, 5, 6), 0x00FF0000)               # RED flash = r4 was wrong
        a.ldr(4, "TTBR")
        a.emit(0xE3A05015)
        a.bext(KB + 0x114)
        for lbl, col in (("bad_id", 0x00FF0000), ("bad_kva", 0x00FFFF00),
                         ("bad_blob", 0x00FF8000), ("bad_vfb", 0x0080FF00),
                         ("bad_ifb", 0x00008080)):
            a.label(lbl); a.paint((3, 5, 6), col); a.emit(0xEAFFFFFE)
        return a.finish({"TTBR": _PT_TTBR,
                         "PT_ID0": _id0_slot, "PT_ID0X": _id0_exp,
                         "PT_KVA": _kva_slot, "PT_KVAX": _id0_exp,
                         "PT_BLOB": _blob_slot, "PT_BLOBX": _blob_exp,
                         "PT_VFB": _vfb_slot, "PT_VFBX": _vfb_exp,
                         "PT_IFB": _ifb_slot, "PT_IFBX": _ifb_exp}, FB, FBE)
    o["m0"] = add(m0)

    # m0c: replaces mov r0,r0 (PA KB+0x120), still pre-MMU. r0 live; (3,5,6).
    # SCTLR_MINIMAL profiles force r0 := 1 (MMU bit only: no caches, no
    # high vectors, no EE/TRE) instead of the kernel's mask-built value.
    _m0c_mid = [0xE3A00001] if SCTLR_MINIMAL else [0xE1A00000]
    def m0c(b):
        a = Asm(b)
        a.paint((3, 5, 6), 0x00FF80FF)              # LIGHT MAGENTA
        for w in _m0c_mid:
            a.emit(w)                                # mov r0,#1 / mov r0,r0
        a.bext(KB + 0x124)
        return a.finish({}, FB, FBE)
    o["m0c"] = add(m0c, None)

    # m0b: replaces mov r3,sp (PA 0x8130). POST-MMU: fetch via identity
    # (blob < 256MB now identity-mapped), paint via identity-mapped PA FB.
    # r0 live (SCTLR); scratch (3,5,6); force r3 = __mmap_switched VA.
    def m0b(b):
        a = Asm(b)
        a.paint((3, 5, 6), 0x0080FF80)              # PALE GREEN
        a.emit(0xE3A034C0)                          # mov r3,#0xC0000000
        a.emit(0xE2833902)                          # add r3,r3,#0x8000
        a.emit(0xE2833E18)                          # add r3,r3,#0x180
        a.bext(KB + 0x134)
        return a.finish({}, FB, FBE)
    o["m0b"] = add(m0b, None)

    # m1: replaces ldm r3!,{r4-r7} (VA 0xC0008184). POST-MMU, VA fetch.
    # r0 (SCTLR) live until 0x81C0, r1/r2 live, r3 live; scratch (4,5,6).
    # Paint via identity-mapped PA FB (no dependence on kernel VA map).
    # Runs at VA (branch FROM kernel VA->VA, within range).
    _m1_off = off
    def m1(b):
        a = Asm(VCB + _m1_off)
        a.paint((4, 5, 6), 0x00808000)              # OLIVE
        a.emit(0xE8B300F0)                           # ldm r3!,{r4-r7} (re-exec)
        a.bext(VB + 0x188)
        return a.finish({}, FB, FBE)
    o["m1"] = add(m1, None)
    # m2: replaces b start_kernel (VA 0xC00081C4). r0/r4 stored by the
    # preceding stm; all dead here. scratch (4,5,6). Runs at VA.
    _m2_off = off
    def m2(b):
        a = Asm(VCB + _m2_off)
        a.paint((4, 5, 6), 0x0000FF80)              # MINT
        a.bext(VB + 0x5F4)
        return a.finish({}, FB, FBE)
    o["m2"] = add(m2, None)

    # ---- start_kernel bisect cascade (all post-MMU, VA-based) ----
    # Each patches one instruction; the cave paints, RE-EXECUTES the
    # original word, then branches back. For bl sites the called function
    # returns INTO the cave (mid+1) which then branches to the original
    # return site.
    _orig = open(VMLINUX_SRC, "rb").read()
    for nm, off_, col in M_SITES:
        mid_word = struct.unpack_from("<I", _orig, off_)[0]
        def mk2(nm=nm, off_=off_, col=col, mid_word=mid_word, _base_off=off):
            a = Asm(VCB + _base_off)
            a.paint((1, 2, 12), col)
            if (mid_word >> 24) == 0xEB:
                # bl is POSITION-DEPENDENT: re-executing the raw word from
                # the cave would target cave+delta. Re-encode to the call's
                # original target; the callee returns into the cave at the
                # following bext (lr = mid+4 inside the cave).
                tgt = VB + off_ + 8 + (((mid_word & 0xFFFFFF) ^ 0x800000) - 0x800000) * 4
                a.bl(tgt)
            else:
                a.emit(mid_word)
            a.bext(VB + off_ + 4)
            return a.finish({}, FB, FBE)
        o[nm] = add(mk2, None)

    blob = b"".join(struct.pack("<I", w) for c in caves for w in c)
    return blob, o


def _cave_bl(base, scratch, color, call, ret):
    """Paint cave whose mid is a single bl."""
    a = Asm(base)
    a.paint(scratch, color)
    a.bl(call)
    a.bext(ret)
    return a.finish({}, FB, FBE)


# ----------------------------------------------------------------------------
# 2. vmlinux patch set (branch words only - image stays original size)
# ----------------------------------------------------------------------------
def patch_vmlinux(offs):
    v = bytearray(open(VMLINUX_SRC, "rb").read())
    assert len(v) == 2644416
    patches = [
        (0x00, offs["c0"]), (0x0C, offs["cA"]),
        (0x12F94, offs["cL"]), (0x12FD4, offs["cD"]),
        (0x24, offs["k1"]), (0x28, offs["k2"]),
        (0x34, offs["k3"]), (0x3C, offs["k4"]),
        (0x138, offs["v1"]), (0x160, offs["v2"]), (0x164, offs["v3"]),
        (0x110, offs["m0"]), (0x120, offs["m0c"]), (0x130, offs["m0b"]),
    ]
    for off, tgt in patches:
        # offs values are ALREADY absolute PA (CB + file offset) - no extra CB
        struct.pack_into("<I", v, off, B(KB + off, tgt))
    struct.pack_into("<I", v, 0x184, B(VB + 0x184, VCB + (offs["m1"] - CB)))
    struct.pack_into("<I", v, 0x1C4, B(VB + 0x1C4, VCB + (offs["m2"] - CB)))
    for nm, off_, col in M_SITES:
        struct.pack_into("<I", v, off_, B(VB + off_, VCB + (offs[nm] - CB)))
    # 256MB kernel-VA map AND 256MB identity map (covers PA FB 0x0F700000,
    # so post-MMU PA paints work without touching the kernel VA map).
    struct.pack_into("<I", v, 0xFC, 0xD0000000)
    struct.pack_into("<I", v, 0x108, 0xD0000000)
    return v


# ----------------------------------------------------------------------------
# 3. zImage assembly
# ----------------------------------------------------------------------------
def build_zimage(patched_v):
    # The piggy delta MUST be 0 mod 4: the decompressor's BSS/heap/stack
    # pointers all shift by delta, and a 2-mod-4 delta caused misaligned
    # STRs -> abort -> vector word 0x14 (aliased PA 0) -> zImage re-entry
    # loop (symptom: show cycles / sticks on white).
    # Tail padding with INCOMPRESSIBLE bytes grows the gzip ~1:1, so a
    # pad of 0..3 always lands an aligned delta. The pad rides past the
    # kernel image end (harmless; truncation boundary is ~+260 and the
    # real cave code lives in kcaves.bin, not in the vmlinux tail).
    FILLER = bytes(((0xA5 + i * 13) & 0xFF) for i in range(64))
    pad = None
    for n in range(0, 4):
        pig = gzip.compress(bytes(patched_v) + FILLER[:n], 9)
        if (len(pig) - OLD_PIGGY_LEN) % 4 == 0:
            pad = n
            break
    assert pad is not None, "no aligned pad found"
    assert 2644416 + pad < TRUNCATION_LIMIT, "tail would be truncated"
    delta = len(pig) - OLD_PIGGY_LEN
    assert delta % 4 == 0, "delta misaligned"

    z = bytearray(open(KERNEL_SRC, "rb").read())
    # trailer: shift post-piggy offsets, pre-apply runtime base (+BASE)
    tr = bytearray(z[OLD_END:])
    for k in range(9):
        o = 2 + 4 * k
        w = struct.unpack_from("<I", tr, o)[0]
        if 0x149386 <= w <= 0x14B000:
            w += delta
        struct.pack_into("<I", tr, o, w + BASE)
    # NOTE: trailer words sit at tr-relative offset 2 (file 0x14938C+4k)
    # params table (0x180..0x19C; [0]=0x17C self) + code pool literals
    for o in range(0x180, 0x19C, 4):
        w = struct.unpack_from("<I", z, o)[0]
        if 0x149386 <= w <= 0x14B000:
            struct.pack_into("<I", z, o, w + delta)
    for o in (0xBA0, 0xC4C, 0xD60):
        struct.pack_into("<I", z, o, struct.unpack_from("<I", z, o)[0] + delta)
    # head patches (proven set)
    for o in (0x04, 0x0C, 0x14, 0x1C):
        struct.pack_into("<I", z, o, BASE + 0x20)
    struct.pack_into("<I", z, 0x7CC, KB)               # zreladdr (head literal)
    struct.pack_into("<I", z, 0x64, 0xE1A00000)               # skip cache_on
    for o in (0x164, 0x170, 0x174):
        struct.pack_into("<I", z, o, 0xE1A00000)
    struct.pack_into("<I", z, 0x7E4, BASE + 0x540)    # console->ret (profile base!)
    struct.pack_into("<I", z, 0x10C, B(BASE + 0x10C, BASE + 0x118))  # skip fixup adds
    struct.pack_into("<I", z, 0x120, B(BASE + 0x120, BASE + 0x134))  # skip fixup loop

    out = bytearray(z[:PIGGY_OFF]) + pig + tr
    while len(out) % 4:
        out.append(0)          # cave region 4-aligned (ARM state requirement)

    # zImage-side caves
    C1 = BASE + len(out)
    b1 = cave(C1, (0, 3, 4), 0xFFFFFFFF, [0xE1A07001], BASE + 0x34)   # white; re-exec mov r7,r1
    CP1 = C1 + len(b1) * 4
    p1 = cave(CP1, (3, 5, 6), 0xFF0000FF, [0xE8901E4E], BASE + 0x70)  # blue; ldm params
    CPX = CP1 + len(p1) * 4
    px = cave(CPX, (1, 9, 5), 0x00FFFF00, [0xE28D9801], BASE + 0xA4)  # yellow; add sl,sp,#0x10000
    CPY = CPX + len(px) * 4
    py = cave(CPY, (1, 5, 9), 0x0000FF00, [0xE3300000], BASE + 0x10C) # green; teq r0,#0
    CP2 = CPY + len(py) * 4
    p2 = cave(CP2, (0, 1, 5), 0x00FF0000, [0xE3A00000], BASE + 0x138)  # red; mov r0,#0
    C2 = CP2 + len(p2) * 4
    b2 = cave(C2, (0, 1, 2), 0xFFFF0000, [0xE1A00004], BASE + 0x154)  # red; mov r0,r4

    # caveD: real decompress_kernel call (0x0B0C), sp aligned, r4/r7/r8 saved
    CD = C2 + len(b2) * 4
    a = Asm(CD)
    a.paint((3, 5, 6), 0x0000FFFF)                                  # cyan
    a.emit(0xE3CDD003); a.emit(0xE1A0100D); a.emit(0xE28D2801)
    a.emit(0xE92D0190)                                              # push {r4,r7,r8}
    a.bl(BASE + 0x0B0C)
    a.emit(0xE8BD0190)                                              # pop
    a.paint((3, 5, 6), 0x00000000)                                 # black
    a.bext(BASE + 0x164)
    cd = a.finish({}, FB, FBE)

    C3 = CD + len(cd) * 4
    vwords = gzip.decompress(bytes(pig))
    e = {
        "ENTRY": struct.unpack_from("<I", vwords, 0)[0],
        "C0W": struct.unpack_from("<I", open(KERNEL_SRC, "rb").read(), 0)[0],  # placeholder, fixed below
    }
    # handoff diagnostic: entry word, r4 == 0x8000, then protocol jump
    a = Asm(C3)
    a.paint((0, 1, 2), 0x000000FF)                                  # blue
    a.ldr(0, "K8000"); a.emit(0xE5901000); a.ldr(2, "ENTRY")
    a.emit(0xE1510002); a.br(0x1A, "h_yellow")
    a.ldr(0, "K8000"); a.emit(0xE1540000); a.br(0x1A, "h_green")
    a.emit(0xE3A00000); a.emit(0xE1A01007); a.emit(0xE1A02008); a.emit(0xE1A0F004)
    for lbl, col in (("h_yellow", 0x00FFFF00), ("h_green", 0x0000FF00)):
        a.label(lbl); a.paint((0, 1, 2), col); a.emit(0xEAFFFFFE)
    b3 = a.finish({"K8000": KB, "ENTRY": e["ENTRY"]}, FB, FBE)

    CE = C3 + len(b3) * 4
    ce = cave(CE, (0, 1, 2), 0xFF00FF00, [0xEAFFFFFE], None)        # green = decompressor error
    out += b"".join(struct.pack("<I", w) for c in (b1, p1, px, py, p2, b2, cd, b3, ce) for w in c)
    for off, tgt in ((0x30, C1), (0x6C, CP1), (0xA0, CPX), (0x108, CPY),
                    (0x134, CP2), (0x150, C2), (0x160, CD), (0x178, C3), (0x9E4, CE)):
        struct.pack_into("<I", out, off, B(BASE + off, tgt))
    return bytes(out), delta, 0


# ----------------------------------------------------------------------------
# 4. Full audit - re-derives everything independently; aborts on any error.
# ----------------------------------------------------------------------------
def audit(zimg, blob, offs):
    md = None
    try:
        import capstone
        md = capstone.Cs(capstone.CS_ARCH_ARM, capstone.CS_MODE_ARM)
        md.skipdata = True
    except ImportError:
        pass
    errs, n = [], 0

    def chk(cond, msg):
        nonlocal n
        n += 1
        if not cond:
            errs.append(msg)

    # --- page-table slot arithmetic, derived from profile constants ---
    vfb = PAGE_OFFSET + (FB - RAM_BASE)
    chk(vfb % 0x100000 == 0 and vfb >> 20 == 0xC00 + ((FB - RAM_BASE) >> 20),
        "VFB arithmetic %x" % vfb)
    slot_vfb = 0x7000 + 4 * ((vfb >> 20) - 0xC00)
    chk(4 * ((vfb >> 20) - 0xC00) == 4 * ((FB - RAM_BASE) >> 20),
        "VFB slot %x" % slot_vfb)
    slot_ifb = 4 * (FB >> 20)
    chk(slot_ifb == 4 * (FB >> 20), "IFB slot %x" % slot_ifb)

    # --- vmlinux patches ---
    params = struct.unpack_from("<8I", zimg, 0x17C)
    delta = params[1] - 0x1493C0
    plen = OLD_PIGGY_LEN + delta
    vv = gzip.decompress(zimg[PIGGY_OFF:PIGGY_OFF + plen])
    chk(2644416 <= len(vv) <= 2644416 + 3, "vv size %d" % len(vv))
    chk(len(vv) < TRUNCATION_LIMIT, "decompressed %d over truncation limit" % len(vv))
    for off, nm in [(0x00, "c0"), (0x0C, "cA"), (0x12F94, "cL"), (0x12FD4, "cD"),
                    (0x24, "k1"), (0x28, "k2"), (0x34, "k3"), (0x3C, "k4"),
                    (0x110, "m0"), (0x120, "m0c"), (0x130, "m0b")]:
        t = brtarget(struct.unpack_from("<I", vv, off)[0], KB + off)
        chk(t == offs[nm], "v[%x]->%s = %x (want %x)" % (off, nm, t, offs[nm]))
    for off, nm in [(0x184, "m1"), (0x1C4, "m2")] + [(o_, n) for n, o_, _c in M_SITES]:
        t = brtarget(struct.unpack_from("<I", vv, off)[0], VB + off)
        chk(t == VCB + (offs[nm] - CB), "v[%x]->%s(VA) = %x" % (off, nm, t))
    chk(struct.unpack_from("<I", vv, 0xFC)[0] == 0xD0000000, "0xFC")
    chk(struct.unpack_from("<I", vv, 0x108)[0] == 0xD0000000, "0x108")
    # only intended words differ from pristine
    orig = open(VMLINUX_SRC, "rb").read()
    patched = {0x00, 0x0C, 0x12F94, 0x12FD4, 0x24, 0x28, 0x34, 0x3C, 0x138,
               0x160, 0x164, 0x110, 0x120, 0x130, 0x184, 0x1C4, 0xFC, 0x108}
    for o in range(0, 2644416 - 3, 4):
        if o not in patched:
            chk(struct.unpack_from("<I", vv, o)[0] == struct.unpack_from("<I", orig, o)[0],
                "unexpected diff at %x" % o) if o < 0x200 or o in (0x12F94,) else None
    # key intact words
    chk(struct.unpack_from("<I", vv, 0x40)[0] == 0xC0008180, "sp->__mmap_switched")
    chk(struct.unpack_from("<I", vv, 0x13208)[0] == 0x10C03C7D, "SCTLR set mask (M=1)")
    chk(struct.unpack_from("<I", vv, 0x139B4)[0] == 0x410FC090, "proc id")

    # --- blob ---
    # offs values are ABSOLUTE PA (0x300000+); convert to file offsets here.
    chk(len(blob) % 4 == 0, "blob alignment")
    # m2 is 13 words; allow its tail to reach the blob end exactly
    chk(max(offs.values()) + 52 <= CB + len(blob), "blob covers all cave offsets")
    for nm, scr in (("c0", (0, 3, 4)), ("cL", (0, 4, 5)), ("cA", (0, 3, 4)),
                    ("cD", (0, 1, 2)), ("k1", (0, 3, 6)), ("k2", (0, 3, 6)),
                    ("k3", (0, 3, 6)), ("k4", (3, 5, 6)), ("v1", (0, 5, 6)),
                    ("v2", (0, 5, 6)), ("v3", (0, 5, 6)),
                    ("m0", (3, 5, 6)), ("m0c", (3, 5, 6)), ("m0b", (3, 5, 6)),
                    ("m1", (4, 5, 6)), ("m2", (4, 5, 6))):
        o = offs[nm] - CB
        first = struct.unpack_from("<I", blob, o)[0]
        want = 0xE59F0000 | (scr[0] << 12)
        chk((first & 0xFFF0F000) == (want & 0xFFF0F000),
            "%s scratch reg %08x want %08x" % (nm, first, want))
        for k in range(3):
            w = struct.unpack_from("<I", blob, o + 4 * k)[0]
            chk(w >> 16 == 0xE59F, "%s ldr%d insn" % (nm, k))
    # every branch in blob lands somewhere sane — EXCEPT the m3-m10 caves'
    # mid words (the original bl instructions, re-executed data, decoded
    # here would use blob-relative offsets = garbage by design)
    skip_mids = {offs[nm] - CB + 36 for nm, _o, _c in M_SITES}
    for o in range(0, len(blob) - 3, 4):
        if o in skip_mids:
            continue
        w = struct.unpack_from("<I", blob, o)[0]
        if (w >> 24) in (0xEA, 0xEB):
            t = brtarget(w, CB + o)
            chk((CB <= t < CB + len(blob)) or (KB <= t < KB + 0x290000)
                or (VB <= t < VB + 0x290000) or t == KB + 0x8124,
                "blob branch @%x -> %x" % (o, t))
    if md is not None:
        # m0b/m1/m2 paint literals must be PHYSICAL FB (identity-mapped now)
        # literal block layout at cave end: COL, FB, FBE (Asm.finish order)
        for nm, nwords in (("m0b", 16), ("m1", 14), ("m2", 13)):
            oo = offs[nm] - CB
            lit = struct.unpack_from("<3I", blob, oo + (nwords - 3) * 4)
            chk(lit[1] == FB and lit[2] == FBE,
                "%s literals %s (want PA FB at [1])" % (nm, [hex(x) for x in lit]))

    # --- zImage head ---
    for o in (0x04, 0x0C, 0x14, 0x1C):
        chk(struct.unpack_from("<I", zimg, o)[0] == BASE + 0x20, "tramp %x" % o)
    chk(struct.unpack_from("<I", zimg, 0x7CC)[0] == KB, "zreladdr literal")
    chk(struct.unpack_from("<I", zimg, 0x168)[0] == 0xEB0000FC, "0x168 bl cache_off")
    ntr = PIGGY_OFF + plen
    chk(struct.unpack_from("<I", zimg, ntr + 2)[0] == BASE + OLD_END + delta, "input_data_end")
    chk(struct.unpack_from("<I", zimg, ntr + 2 + 8)[0] == BASE + 0x469B, "input_data")
    for o in (0xBA0, 0xC4C, 0xD60):
        chk(struct.unpack_from("<I", zimg, o)[0] ==
            {0xBA0: 0x14886C, 0xC4C: 0x1487B0, 0xD60: 0x14865C}[o] + delta, "pool %x" % o)
    for off in (0x30, 0x6C, 0xA0, 0x108, 0x134, 0x150, 0x160, 0x178, 0x9E4):
        t = brtarget(struct.unpack_from("<I", zimg, off)[0], BASE + off)
        chk(t % 4 == 0 and t >= BASE + ntr, "head branch %x -> %x" % (off, t))
    # decompressor call present in cave region (scan every byte offset;
    # the region start moves with delta and may sit at 2 mod 4)
    found = any(struct.unpack_from("<I", zimg, o)[0] >> 24 == 0xEB and
                brtarget(struct.unpack_from("<I", zimg, o)[0], BASE + o) == BASE + 0x0B0C
                for o in range(ntr, len(zimg) - 3))
    chk(found, "caveD bl 0x0B0C")
    # every pointer the decompressor uses must stay word-aligned
    for nm, o in (("params[1]", 0x184), ("params[7]", 0x198)):
        chk(struct.unpack_from("<I", zimg, o)[0] % 4 == 0, "%s misaligned" % nm)
    chk(delta % 4 == 0, "delta %d misaligned" % delta)

    # every branch that TARGETS a head/kernel address must be unconditional
    for o in range(0, len(blob) - 3, 4):
        w = struct.unpack_from("<I", blob, o)[0]
        if (w >> 24) in (0xEA, 0xEB):
            t = brtarget(w, CB + o)
            if (KB <= t < KB + 0x290000) or (VB <= t < VB + 0x290000) or t == KB + 0x8124:
                chk((w >> 28) == 0xE, "return branch @%x is conditional (%x)!" % (o, w >> 28))
    # same for zImage cave region
    for o in range(ntr, len(zimg) - 3):
        w = struct.unpack_from("<I", zimg, o)[0]
        if (w >> 24) in (0xEA, 0xEB):
            t = brtarget(w, BASE + o)
            if t < BASE + ntr:
                chk((w >> 28) == 0xE, "zImage return branch @%x conditional!" % o)

    return n, errs


def build_qemu_stub():
    """Minimal QEMU stub at 0x42000000: ATAGs at RAM+0x100, boot protocol,
    jump to zImage entry (BASE+0x20). No copy/verify (loader placed files)."""
    atag_addr = RAM_BASE + 0x100
    cmdline = b"console=t4fb0 loglevel=8 rdinit=/init\0"
    cmdline += b"\0" * ((-len(cmdline)) % 4)
    atags = b"".join(struct.pack("<I", x) for x in (
        5, 0x54410001, 1, 0x1000, 0,          # CORE
        4, 0x54410002, RAM_BASE, 0x10000000,   # MEM 256M
        len(cmdline) // 4 + 2, 0x54410009,     # CMDLINE
    )) + cmdline + struct.pack("<I", 0) * 2
    w = lambda *v: b"".join(struct.pack("<I", x) for x in v)
    body = [
        0xE59F0024,                    # 0x00 ldr r0, =atags_src (lit@0x2C)
        0xE59F1024,                    # 0x04 ldr r1, =atags_dst (lit@0x30)
        0xE59F2024,                    # 0x08 ldr r2, =atags_end (lit@0x34)
        0xE4903004,                    # 0x0C ldr r3,[r0],#4
        0xE4813004,                    # 0x10 str r3,[r1],#4
        0xE1500002,                    # 0x14 cmp r0,r2 (SOURCE PTR vs end!)
        0x1AFFFFFB,                    # 0x18 bne copy
        0xE3A00000,                    # 0x1C mov r0,#0
        0xE3A01EDC,                    # 0x20 mov r1,#3564 (0xDC ror 28 = 0xDC4)
        0xE59F200C,                    # 0x24 ldr r2, =atag_addr (lit@0x38)
        0xE59FF00C,                    # 0x28 ldr pc, =BASE+0x20 (lit@0x3C)
    ]
    atags_src = 0x42000000 + 11 * 4 + 5 * 4
    lits = [atags_src, atag_addr, atags_src + len(atags), atag_addr, BASE + 0x20]
    stub = bytearray(w(*body) + w(*lits) + atags)
    open(os.path.join(KIT, "stub.bin"), "wb").write(bytes(stub))
    return bytes(stub)


def main():
    profile = sys.argv[1] if len(sys.argv) > 1 else "phone"
    set_profile(profile)
    os.makedirs(KIT, exist_ok=True)
    blob, offs = build_blob()
    open(os.path.join(KIT, "kcaves.bin"), "wb").write(blob)

    v = patch_vmlinux(offs)
    zimg, delta, pad = build_zimage(v)
    open(os.path.join(KIT, "zImage"), "wb").write(zimg)

    n, errs = audit(zimg, blob, offs)
    if errs:
        print("AUDIT FAILED (%d checks):" % n)
        for e in errs:
            print("  -", e)
        sys.exit(1)

    # stub: phone = proven t4stub; qemu = minimal loader stub
    if profile == "qemu":
        build_qemu_stub()
    else:
        subprocess.run([sys.executable, os.path.join(HERE, "build-t4stub.py"),
                        os.path.join(KIT, "stub.bin")], check=True)

    if profile == "qemu":
        sh = """#!/usr/bin/env bash
# QEMU run (virt, 256M, cortex-a7; trace exceptions; HMP on :5555).
cd "%(kit)s"
qemu-system-arm -M virt -cpu cortex-a7 -m 256M -nographic -serial none \\
  -device loader,file=zImage,addr=0x41000000 \\
  -device loader,file=kcaves.bin,addr=0x%(cb)08x \\
  -device loader,file=stub.bin,addr=0x42000000 \\
  -device loader,addr=0x42000000,cpu-num=0 \\
  -d int,guest_errors -D qemu-trace.log \\
  -monitor telnet:127.0.0.1:5555,server,nowait
""" % {"kit": KIT, "cb": CB}
        open(os.path.join(KIT, "run-qemu.sh"), "w").write(sh)
        os.chmod(os.path.join(KIT, "run-qemu.sh"), 0o755)
    else:
        sh = """#!/usr/bin/env bash
# Boot chain (self-healing: bus reset + retry on ACM stalls).
set -e
cd "%(kit)s"
python3 "%(oibsend)s" boot \\
  zImage 0x44000000 %(initrd)s 0x09000000 kcaves.bin 0x%(cb)08x stub.bin 0x04200000 \\
  --go "go 0x04200000"
""" % {"kit": KIT, "oibsend": OIBSEND, "initrd": INITRD_SRC, "cb": CB}
        open(os.path.join(KIT, "boot-android.sh"), "w").write(sh)
        os.chmod(os.path.join(KIT, "boot-android.sh"), 0o755)

    print("AUDIT PASSED: %d checks" % n)
    print("kit: %s (zImage %d bytes, delta %+d, pad %d, kcaves %d)" %
          (KIT, len(zimg), delta, pad, len(blob)))
    print("colors: gray(m0) lmag(m0c) pgreen(m0b) olive(m1) mint(m2) -> start_kernel")
    print("m0 PT hang colors: red=id0 yellow=kva orange=blob lime=vfb teal=idfb")


if __name__ == "__main__":
    main()
