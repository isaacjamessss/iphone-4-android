# Full androidi4 userspace from CPIO in RAM. No physical storage mount actions.
on early-init
    start ueventd

on init
    loglevel 8
    export PATH /sbin:/system/bin:/system/xbin
    export LD_LIBRARY_PATH /system/lib
    export ANDROID_ROOT /system
    export ANDROID_DATA /data
    export ANDROID_ASSETS /system/app
    export EXTERNAL_STORAGE /mnt/sdcard
    export ASEC_MOUNTPOINT /mnt/asec
    export LOOP_MOUNTPOINT /mnt/obb
    export BOOTCLASSPATH /system/framework/core.jar:/system/framework/bouncycastle.jar:/system/framework/ext.jar:/system/framework/framework.jar:/system/framework/android.policy.jar:/system/framework/services.jar:/system/framework/core-junit.jar
    symlink /system/etc /etc
    symlink /system/vendor /vendor
    symlink /mnt/sdcard /sdcard
    symlink /sys/kernel/debug /d
    mkdir /mnt 0775 root system
    mkdir /mnt/sdcard 0770 system sdcard_rw
    mkdir /mnt/secure 0700 root root
    mkdir /mnt/secure/staging 0700 root root
    mkdir /mnt/secure/asec 0700 root root
    mkdir /mnt/asec 0700 root system
    mkdir /mnt/obb 0700 root system
    mkdir /acct 0755 root system
    mount cgroup none /acct cpuacct
    mkdir /dev/cpuctl 0755 system system
    mount cgroup none /dev/cpuctl cpu
    chown system system /dev/cpuctl/tasks
    chmod 0777 /dev/cpuctl/tasks
    mkdir /dev/cpuctl/bg_non_interactive 0775 system system
    chown system system /dev/cpuctl/bg_non_interactive/tasks
    chmod 0777 /dev/cpuctl/bg_non_interactive/tasks
    write /dev/cpuctl/bg_non_interactive/cpu.shares 52
    write /sys/power/wake_lock t4_ui_ram
    write /proc/sys/kernel/panic_on_oops 1
    write /proc/1/oom_adj -16
    write /proc/sys/vm/overcommit_memory 1
    setrlimit 13 40 40

on fs
    mount tmpfs tmpfs /data mode=0771,uid=1000,gid=1000,size=48m
    mount tmpfs tmpfs /cache mode=0770,uid=1000,gid=2001,size=8m

on post-fs
    mkdir /data/property 0700 root root
    mkdir /data/local 0771 shell shell
    mkdir /data/local/tmp 0771 shell shell
    mkdir /data/dalvik-cache 0771 system system
    mkdir /data/data 0771 system system
    mkdir /data/app 0771 system system
    mkdir /data/app-private 0771 system system
    mkdir /data/system 0775 system system
    mkdir /data/anr 0775 system system
    mkdir /data/tombstones 0771 system system
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/keystore 0700 keystore keystore
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    mkdir /data/misc/systemkeys 0700 system system
    mkdir /data/misc/bluetooth 0770 system system
    mkdir /data/misc/vpn 0770 system system
    mkdir /data/misc/vpn/profiles 0770 system system

on boot
    ifup lo
    start t4-usb-setup
    start t4-touch
    hostname localhost
    setprop system_init.startsurfaceflinger 0
    setprop debug.sf.hw 0
    setprop debug.egl.hw 0
    setprop debug.sf.nobootanimation 0
    setprop ro.FOREGROUND_APP_ADJ 0
    setprop ro.VISIBLE_APP_ADJ 1
    setprop ro.PERCEPTIBLE_APP_ADJ 2
    setprop ro.HEAVY_WEIGHT_APP_ADJ 3
    setprop ro.SECONDARY_SERVER_ADJ 4
    setprop ro.BACKUP_APP_ADJ 5
    setprop ro.HOME_APP_ADJ 6
    setprop ro.HIDDEN_APP_MIN_ADJ 7
    setprop ro.EMPTY_APP_ADJ 15
    # Original Android/iDroid memory thresholds, in 4 KiB pages.
    setprop ro.FOREGROUND_APP_MEM 2048
    setprop ro.VISIBLE_APP_MEM 3072
    setprop ro.PERCEPTIBLE_APP_MEM 4096
    setprop ro.HEAVY_WEIGHT_APP_MEM 4096
    setprop ro.SECONDARY_SERVER_MEM 6144
    setprop ro.BACKUP_APP_MEM 6144
    setprop ro.HOME_APP_MEM 6144
    setprop ro.HIDDEN_APP_MEM 7168
    setprop ro.EMPTY_APP_MEM 8192
    write /dev/kmsg <5>T4_ANDROID_UI_07_START_REAL_FRAMEWORK
    start t4-dynamic-probe

service ueventd /sbin/ueventd
    critical

on property:t4.dynamic.ready=1
    write /dev/kmsg <5>T4_DYNAMIC_READY_START_FRAMEWORK
    start t4-logcat
    start t4-critical-log
    class_start android

service t4-dynamic-probe /bin/sh /sbin/t4-dynamic-probe.sh
    disabled
    oneshot

service servicemanager /system/bin/servicemanager
    class android
    user system
    group system
    onrestart restart surfaceflinger
    onrestart restart zygote
    onrestart restart media

# Root is scoped to the standalone SF RAM test: VT console ioctls require
# CAP_SYS_TTY_CONFIG because Android init gives this service no controlling tty.
service surfaceflinger /system/bin/surfaceflinger
    class android
    user root
    group graphics system

service debuggerd /system/bin/debuggerd
    class android

# Empty vold fstab: no volumes, block devices or external storage configured.
service vold /system/bin/vold
    class android
    socket vold stream 0660 root mount

service netd /system/bin/netd
    class android
    socket netd stream 0660 root system

service installd /system/bin/installd
    class android
    socket installd stream 0600 system system

service media /system/bin/mediaserver
    class android
    user media
    group system audio camera graphics inet net_bt net_bt_admin net_raw

service keystore /system/bin/keystore /data/misc/keystore
    class android
    user keystore
    group keystore
    socket keystore stream 0666

service zygote /bin/sh /sbin/t4-zygote.sh
    class android
    socket zygote stream 0666
    oneshot

service t4-logcat /system/bin/logcat -b main -b system -v time -f /data/local/tmp/android.log -r 512 -n 2
    class diagnostics
    disabled
    user root
    group log

service t4-ui-watch /bin/sh /sbin/t4-ui-watch.sh
    class android
    oneshot
    user root
    group root log graphics

service t4-critical-log /bin/sh /sbin/t4-critical-log.sh
    class diagnostics
    disabled
    user root
    group log

service t4-usb-setup /bin/sh /sbin/t4-usb-setup.sh
    disabled
    oneshot
    user root
    group root

service adbd /bin/sh /sbin/t4-adbd.sh
    disabled
    user root
    group root

service t4-touch /bin/sh /sbin/t4-touch-start.sh
    disabled
    oneshot
    user root
    group root input

# n92ap: stock Gingerbread boot animation (built-in ANDROID logo, no zip)
service bootanim /system/bin/bootanimation
    user graphics
    group graphics
    disabled
    oneshot
